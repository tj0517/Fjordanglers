{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(supabase db diff*)",
      "Bash(supabase migration new*)",
      "Bash(supabase gen types*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(.claude/settings.local.json)",
      "Bash(cat .env*)",
      "Bash(printenv*)",
      "Bash(env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/agent-guard.sh"
          }
        ]
      }
    ]
  }
}