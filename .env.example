# FjordAnglers — environment variable NAMES only. Never put values here.
# Copy to .env.local and fill in. Declarations and validation: src/lib/env.ts

# Supabase
NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY

# Stripe
STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY

# App
NEXT_PUBLIC_APP_URL
PLATFORM_COMMISSION_RATE

# Email (Resend)
RESEND_API_KEY

# Security / observability
SENTRY_DSN
IBAN_ENCRYPTION_KEY

# Rate limit on POST /api/inquiries (optional; the limiter is off when any is missing)
UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN
RATE_LIMIT_SALT

# Feature flags (values are the literal strings "true" / "false"; default false)
EXPERIENCE_V2_ENABLED

# Web push (FA-M.12) — VAPID keys. Optional: without all three, push is off (requests still go out on WhatsApp). Private key is server-only, never NEXT_PUBLIC_*.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
